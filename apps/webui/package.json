{
  "name": "lingchu-bot-webui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "files": [
    "dist/server",
    "build/client",
    "build/server",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "react-router build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "react-router dev",
    "start": "react-router build && npm run build:server && cross-env NODE_ENV=production node dist/server/index.js",
    "prepack": "pnpm build && pnpm build:server",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@hono/node-server": "^2.0.11",
    "@react-router/node": "^8",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "hono": "^4.12.34",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.1.36",
    "jose": "^6.0.0",
    "lucide-react": "1.25.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.7.4",
    "react-router": "^8",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
